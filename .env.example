# ── Banco de dados ─────────────────────────────────────
# SQL Server local — ajuste server, porta, database e credenciais
DATABASE_URL="sqlserver://localhost:1433;database=WixDash;user=sa;password=SuaSenha123!;trustServerCertificate=true"

# ── JWT ────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
