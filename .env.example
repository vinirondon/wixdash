# ── App Wix (dev.wix.com) ──────────────────────────────
WIX_CLIENT_ID=cole_seu_client_id_aqui
WIX_CLIENT_SECRET=cole_seu_client_secret_aqui
# Deve ser exatamente a URL cadastrada no painel do app Wix
WIX_REDIRECT_URI=http://localhost:3000/api/wix/callback

# ── URLs ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
