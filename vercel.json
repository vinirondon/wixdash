{
  "version": 2,
  "buildCommand": null,
  "rewrites": [
    {
      "source": "/api/auth/register",
      "destination": "/api/auth/register"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login"
    },
    {
      "source": "/api/wix/connect",
      "destination": "/api/wix/connect"
    },
    {
      "source": "/api/wix/callback",
      "destination": "/api/wix/callback"
    },
    {
      "source": "/api/wix/data",
      "destination": "/api/wix/data"
    },
    {
      "source": "/api/wix/disconnect",
      "destination": "/api/wix/disconnect"
    },
    {
      "source": "/api/sync/run",
      "destination": "/api/sync/run"
    },
    {
      "source": "/api/staff/commission",
      "destination": "/api/staff/commission"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}